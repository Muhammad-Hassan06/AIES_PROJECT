# CyberShield AI Configuration

# Server Settings
PROJECT_NAME="CyberShield AI"
VERSION="1.1.0"
API_V1_STR="/api"

# LLM Provider Configuration & Auto-Fallback
# Supported options: auto, gemini, groq, openai, anthropic, deterministic
LLM_PROVIDER="auto"

# Google Gemini API (Recommended free-tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq Cloud API (Free-tier ultra-fast LLaMA inference)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI API (Optional)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Digital Footprint Discovery Providers (Optional external adapters)
# Supported search providers: google, bing, custom
DISCOVERY_SEARCH_PROVIDER=""
DISCOVERY_SEARCH_API_KEY=""

# Supported exposure checking providers: hibp, dehashed, custom
EXPOSURE_CHECK_PROVIDER=""
EXPOSURE_CHECK_API_KEY=""

# Cryptographic & Privacy Keys
HMAC_SECRET_KEY="replace-with-a-secure-random-hmac-secret-key-in-production"

# Security & Safe Network Inspection
SAFE_FETCH_ENABLED="false"
MAX_UPLOAD_SIZE_BYTES=10485760

# Database Persistence
DATABASE_URL="sqlite:///./backend/data/cybershield.db"

# Official Pakistan Incident Portals
PKCERT_REPORT_URL="https://pkcert.gov.pk/report-incident/"
NCCIA_PORTAL_URL="https://complaint.nccia.gov.pk/"
NCCIA_WEBSITE_URL="https://www.nccia.gov.pk/"
PTA_SPAM_COMPLAINT_URL="https://complaint.pta.gov.pk/"
